# ==============================================================================
# LIFELINK — Git Ignore Configuration
# ==============================================================================

# Node Modules & Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secret Credentials
.env
.env.*
*.env
*.env.local
backend/.env
frontend/.env
!*.env.example

# Build Artifacts & Static Dist
dist/
**/dist/
build/
.vite/
*.tsbuildinfo

# Uploaded Files & Temporary Storage
backend/uploads/*
!backend/uploads/.gitkeep
temp/
tmp/

# OS & Editor Specific Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database storage (if local mongo data)
data/
*.sqlite
